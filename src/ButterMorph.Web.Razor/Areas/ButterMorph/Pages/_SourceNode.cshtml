@model ButterMorph.Web.Razor.SchemaTreeDisplayNode

@{
    string displayType = string.IsNullOrWhiteSpace(Model.DisplayType) ? Model.DataType : Model.DisplayType;
}

@if (Model.Children.Count > 0)
{
    <details class="bm-tree-node bm-source-node">
        <summary class="bm-source-branch"
                 draggable="@Model.CanDrag.ToString().ToLowerInvariant()"
                 data-path="@Model.Path"
                 data-kind="@Model.Kind"
                 data-data-type="@Model.DataType"
                 data-field-key="@Model.Path"
                 data-field-description="@Model.Description"
                 aria-label="@Model.Path">
            <span class="bm-node-name">@Model.Name</span>
            <span class="bm-node-meta">@displayType</span>
            <span class="bm-sidebar-tooltip bm-source-field-tooltip" role="tooltip">
                <span><strong>Key</strong><span>@Model.Path</span></span>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span><strong>Description</strong><span>@Model.Description</span></span>
                }
            </span>
        </summary>
        <div class="bm-tree-children">
            @foreach (var child in Model.Children)
            {
                <partial name="_SourceNode" model="child" />
            }
        </div>
    </details>
}
else
{
    <button type="button"
            class="bm-source-field"
            draggable="@Model.CanDrag.ToString().ToLowerInvariant()"
            data-path="@Model.Path"
            data-kind="@Model.Kind"
            data-data-type="@Model.DataType"
            data-field-key="@Model.Path"
            data-field-description="@Model.Description"
            aria-label="@Model.Path">
        <span class="bm-node-name">@Model.Name</span>
        <span class="bm-node-meta">@displayType</span>
        <span class="bm-sidebar-tooltip bm-source-field-tooltip" role="tooltip">
            <span><strong>Key</strong><span>@Model.Path</span></span>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <span><strong>Description</strong><span>@Model.Description</span></span>
            }
        </span>
    </button>
}
