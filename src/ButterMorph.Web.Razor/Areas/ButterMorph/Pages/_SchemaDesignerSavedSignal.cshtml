@model System.ValueTuple<string, bool, string>
@if (Model.Item2)
{
    <script>
        (function () {
            var message = { type: "@Model.Item1", contextKey: new URLSearchParams(window.location.search).get("context") || "" };
            if (window.opener) {
                window.opener.postMessage(message, window.location.origin);
                window.close();
                return;
            }

            var returnUrl = "@Model.Item3";
            if (returnUrl) {
                window.location.href = returnUrl;
            }
        })();
    </script>
}