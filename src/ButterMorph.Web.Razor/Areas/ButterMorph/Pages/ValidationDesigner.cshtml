@page "/buttermorph/validations/designer"
@model ButterMorph.Web.Razor.ValidationDesignerModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ButterMorph Validation Designer</title>
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/codemirror.min.css?v=codemirror-5-65-16" />
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/show-hint.min.css?v=codemirror-5-65-16" />
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/designer.css?v=validation-designer-1" />
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/codemirror.min.js?v=codemirror-5-65-16"></script>
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/show-hint.min.js?v=codemirror-5-65-16"></script>
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-theme.js?v=1" defer></script>
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/validation-designer.js?v=validation-designer-1"></script>
</head>
<body style="@Model.ThemeStyle" data-bm-theme-mode="@Model.ThemeMode">
    <main class="bm-workbench bm-validation-workbench"
          data-active-view="@Model.ActiveView"
          data-left-dock-mode="pinned"
          data-host-save-completed="@Model.HostSaveCompleted.ToString().ToLowerInvariant()"
          data-host-context-key="@Model.SavedContextKey"
          data-host-return-url="@Model.SafeReturnUrl">
        <header class="bm-topbar">
            <div>
                <p class="bm-kicker">ButterMorph</p>
                <h1>Validation Designer</h1>
            </div>
            <div class="bm-view-toggle" role="group" aria-label="Designer view">
                <button type="button" class="bm-view-button" data-view="Visual">Visual Designer</button>
                <button type="button" class="bm-view-button" data-view="Dsl">DSL</button>
            </div>
        </header>

        <section class="bm-message-box @(((string.IsNullOrWhiteSpace(Model.Message) || Model.Message == "Ready.") && Model.Diagnostics.Count == 0) ? "bm-message-hidden" : string.Empty)" data-message-box="true">
            <span data-message-text="true">@Model.Message</span>
            @if (Model.Diagnostics.Count > 0)
            {
                <strong data-diagnostics-count="true">@Model.Diagnostics.Count diagnostics</strong>
            }
            else
            {
                <strong data-diagnostics-count="true">Ready</strong>
            }
            <button type="button" class="bm-message-action" data-message-dsl="true" hidden>Open DSL</button>
            <button type="button" class="bm-message-close" data-message-close="true">&times;</button>
        </section>

        <section class="bm-workspace">
            <aside class="bm-left-dock" data-left-dock="true">
                <div class="bm-dock-tabs" role="tablist" aria-label="Validation designer tool windows">
                    <button type="button"
                            class="bm-dock-tab"
                            data-dock-tab="sources"
                            role="tab"
                            aria-selected="true"
                            title="Sources">
                        Sources
                    </button>
                    <button type="button"
                            class="bm-dock-tab"
                            data-dock-tab="functions"
                            role="tab"
                            aria-selected="false"
                            title="Functions">
                        Functions
                    </button>
                </div>

                <div class="bm-dock-panel-host" data-dock-panel-host="true">
                    <section class="bm-dock-panel bm-toolbox" data-dock-panel="sources" tabindex="-1">
                        <div class="bm-dock-titlebar bm-panel-title">
                            <h2>Sources</h2>
                            <button type="button" class="bm-dock-pin bm-toolbox-pin" data-dock-pin="sources" data-pin-state="pinned" aria-pressed="true" title="Auto hide panel"><span class="bm-pin-icon" aria-hidden="true"></span></button>
                        </div>

                        <div class="bm-dock-content bm-toolbox-content">
                            @if (Model.SourceSchemas.Count == 0)
                            {
                                <p class="bm-empty">No sources loaded.</p>
                            }

                            <div class="bm-source-list">
                                @foreach (var source in Model.SourceSchemas)
                                {
                                    <article class="bm-source-card">
                                        <details class="bm-source-group">
                                            <summary class="bm-source-group-header">
                                                <span class="bm-source-title-wrap">
                                                    <span class="bm-node-name bm-source-title" tabindex="0">@source.DisplayName</span>
                                                    <span class="bm-source-tooltip" role="tooltip">
                                                        <span><strong>Id</strong><span>@source.Key</span></span>
                                                        @if (!string.IsNullOrWhiteSpace(source.Description))
                                                        {
                                                            <span><strong>Description</strong><span>@source.Description</span></span>
                                                        }
                                                        @if (source.Tags.Count > 0)
                                                        {
                                                            <span><strong>Tags</strong><span>@string.Join(", ", source.Tags)</span></span>
                                                        }
                                                        <span><strong>Schema</strong><span>@source.SchemaKey · v@source.Version</span></span>
                                                        @if (!string.IsNullOrWhiteSpace(source.Topic))
                                                        {
                                                            <span><strong>Topic</strong><span>@source.Topic</span></span>
                                                        }
                                                    </span>
                                                </span>
                                                <span class="bm-source-badge">Source</span>
                                            </summary>
                                            <div class="bm-source-tree">
                                                @foreach (var child in source.Root.Children)
                                                {
                                                    <partial name="_SourceNode" model="child" />
                                                }
                                            </div>
                                        </details>
                                    </article>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="bm-dock-panel bm-function-toolbox" data-dock-panel="functions" tabindex="-1" hidden>
                        <div class="bm-dock-titlebar bm-panel-title">
                            <h2>Functions</h2>
                            <button type="button" class="bm-dock-pin bm-toolbox-pin" data-dock-pin="functions" data-pin-state="pinned" aria-pressed="true" title="Auto hide panel"><span class="bm-pin-icon" aria-hidden="true"></span></button>
                        </div>

                        <div class="bm-dock-content bm-function-content">
                            <div class="bm-function-search">
                                <input type="search" placeholder="Search functions" data-function-search="true" aria-label="Search functions" />
                            </div>

                            @if (Model.FunctionCategories.Count == 0)
                            {
                                <p class="bm-empty">No functions registered.</p>
                            }

                            <div class="bm-function-list">
                                @foreach (var category in Model.FunctionCategories)
                                {
                                    <details class="bm-function-group">
                                        <summary class="bm-function-group-header">
                                            <span>@category.Name</span>
                                            <span>@category.Functions.Count</span>
                                        </summary>
                                        <div class="bm-function-group-items">
                                            @foreach (var function in category.Functions)
                                            {
                                                <button type="button"
                                                        class="bm-function-item"
                                                        draggable="true"
                                                        data-function-template="@function.Template"
                                                        data-function-search-text="@function.Category @function.Key @function.DisplayName @function.Description"
                                                        title="@function.Description">
                                                    <span class="bm-function-key">@function.Key</span>
                                                    <span class="bm-function-kind">@function.ValueKind</span>
                                                    <span class="bm-function-template">@function.Template</span>
                                                </button>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        </div>
                    </section>
                </div>
            </aside>

            <section class="bm-designer-surface" data-view-panel="Visual">
                <form method="post" asp-page-handler="SaveValidationDocument" class="bm-validation-form" data-validation-form="true">
                    @Html.AntiForgeryToken()
                    <div class="bm-canvas-header">
                        <div>
                            <h2>Validation document</h2>
                        </div>
                        <button type="submit">Save validations</button>
                    </div>

                    <section class="bm-validation-section">
                        <div class="bm-validation-section-header">
                            <h3>Assertions</h3>
                            <div class="bm-validation-section-actions">
                                <button type="button" data-add-assertion="true">Add assertion</button>
                            </div>
                        </div>
                        <div class="bm-validation-grid" data-assertion-list="true">
                            @foreach (var assertion in Model.Assertions)
                            {
                                <div class="bm-validation-row bm-validation-row-assertion" data-assertion-row="true">
                                    <div class="bm-validation-row-top">
                                        <label>
                                            Type
                                            <select name="AssertionKinds" data-assertion-kind="true" data-validation-input="true">
                                                <option value="Simple" selected="@(assertion.Kind == "Simple" ? "selected" : null)">Simple field rule</option>
                                                <option value="Complex" selected="@(assertion.Kind != "Simple" ? "selected" : null)">Complex assertion</option>
                                            </select>
                                        </label>
                                        <label>
                                            Message
                                            <input name="AssertionMessages" value="@assertion.Message" placeholder="Validation message" data-validation-input="true" />
                                        </label>
                                        <button type="button" class="bm-validation-row-remove" data-remove-row="true">Remove</button>
                                    </div>
                                    <div class="bm-simple-rule-panel" data-simple-rule-panel="true" hidden="@(assertion.Kind != "Simple")">
                                        <label>
                                            Field
                                            <input name="SimpleFieldPaths" value="@assertion.FieldPath" placeholder="$source.quantity" data-simple-field="true" data-validation-input="true" />
                                        </label>
                                        <label>
                                            Operator
                                            <select name="SimpleOperators" data-simple-operator="true" data-validation-input="true">
                                                <option value="exists" selected="@(assertion.Operator == "exists" ? "selected" : null)">required / exists</option>
                                                <option value="notEmpty" selected="@(assertion.Operator == "notEmpty" ? "selected" : null)">not empty</option>
                                                <option value="isEmpty" selected="@(assertion.Operator == "isEmpty" ? "selected" : null)">is empty</option>
                                                <option value="eq" selected="@(assertion.Operator == "eq" ? "selected" : null)">equals</option>
                                                <option value="neq" selected="@(assertion.Operator == "neq" ? "selected" : null)">not equals</option>
                                                <option value="gt" selected="@(assertion.Operator == "gt" ? "selected" : null)">greater than</option>
                                                <option value="gte" selected="@(assertion.Operator == "gte" ? "selected" : null)">greater or equal</option>
                                                <option value="lt" selected="@(assertion.Operator == "lt" ? "selected" : null)">less than</option>
                                                <option value="lte" selected="@(assertion.Operator == "lte" ? "selected" : null)">less or equal</option>
                                                <option value="contains" selected="@(assertion.Operator == "contains" ? "selected" : null)">contains</option>
                                                <option value="startsWith" selected="@(assertion.Operator == "startsWith" ? "selected" : null)">starts with</option>
                                                <option value="endsWith" selected="@(assertion.Operator == "endsWith" ? "selected" : null)">ends with</option>
                                                <option value="regexMatch" selected="@(assertion.Operator == "regexMatch" ? "selected" : null)">matches regex</option>
                                            </select>
                                        </label>
                                        <label data-simple-value-wrapper="true">
                                            Value
                                            <input name="SimpleValues" value="@assertion.Value" placeholder="10 or $other.field" data-simple-value="true" data-validation-input="true" />
                                        </label>
                                        <input type="hidden" name="AssertionExpressions" value="@assertion.Expression" data-expression-output="true" data-validation-input="true" />
                                    </div>
                                    <div class="bm-complex-assertion-panel" data-complex-assertion-panel="true" hidden="@(assertion.Kind == "Simple")">
                                        <label class="bm-complex-expression">
                                            Expression
                                            <textarea class="bm-expression-input" rows="3" placeholder="and(gt($source.quantity, 10), exists($source.id))" data-complex-expression-editor="true" data-validation-input="true">@assertion.Expression</textarea>
                                        </label>
                                        <details class="bm-condition-builder" data-condition-builder="true">
                                            <summary>Condition builder</summary>
                                            <div class="bm-condition-builder-body">
                                                <label class="bm-condition-mode">
                                                    Mode
                                                    <select data-builder-mode="true">
                                                        <option value="group">Group</option>
                                                        <option value="when">If / then / else</option>
                                                    </select>
                                                </label>
                                                <div data-builder-panel="group">
                                                    <div class="bm-condition-group" data-condition-group="true">
                                                        <div class="bm-condition-group-header">
                                                            <label>
                                                                Match
                                                                <select data-group-operator="true">
                                                                    <option value="and">All conditions</option>
                                                                    <option value="or">Any condition</option>
                                                                </select>
                                                            </label>
                                                            <div class="bm-condition-actions">
                                                                <button type="button" data-add-condition="true">Add condition</button>
                                                                <button type="button" data-add-group="true">Add group</button>
                                                            </div>
                                                        </div>
                                                        <div class="bm-condition-list" data-condition-list="true">
                                                            <div class="bm-condition-row" data-condition-row="true">
                                                                <input data-condition-left="true" placeholder="$source.field" />
                                                                <select data-condition-operator="true">
                                                                    <option value="exists">required / exists</option>
                                                                    <option value="notEmpty">not empty</option>
                                                                    <option value="isEmpty">is empty</option>
                                                                    <option value="eq">equals</option>
                                                                    <option value="neq">not equals</option>
                                                                    <option value="gt">greater than</option>
                                                                    <option value="gte">greater or equal</option>
                                                                    <option value="lt">less than</option>
                                                                    <option value="lte">less or equal</option>
                                                                    <option value="contains">contains</option>
                                                                    <option value="startsWith">starts with</option>
                                                                    <option value="endsWith">ends with</option>
                                                                    <option value="regexMatch">matches regex</option>
                                                                </select>
                                                                <input data-condition-right="true" placeholder="value or $other.field" />
                                                                <button type="button" data-remove-condition="true">Remove</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div data-builder-panel="when" hidden>
                                                    <section class="bm-condition-branch">
                                                        <h4>If</h4>
                                                        <div class="bm-condition-group" data-condition-group="true" data-when-part="condition">
                                                            <div class="bm-condition-group-header">
                                                                <label>
                                                                    Match
                                                                    <select data-group-operator="true">
                                                                        <option value="and">All conditions</option>
                                                                        <option value="or">Any condition</option>
                                                                    </select>
                                                                </label>
                                                                <div class="bm-condition-actions">
                                                                    <button type="button" data-add-condition="true">Add condition</button>
                                                                    <button type="button" data-add-group="true">Add group</button>
                                                                </div>
                                                            </div>
                                                            <div class="bm-condition-list" data-condition-list="true"></div>
                                                        </div>
                                                    </section>
                                                    <section class="bm-condition-branch">
                                                        <h4>Then</h4>
                                                        <div class="bm-condition-group" data-condition-group="true" data-when-part="then">
                                                            <div class="bm-condition-group-header">
                                                                <label>
                                                                    Match
                                                                    <select data-group-operator="true">
                                                                        <option value="and">All conditions</option>
                                                                        <option value="or">Any condition</option>
                                                                    </select>
                                                                </label>
                                                                <div class="bm-condition-actions">
                                                                    <button type="button" data-add-condition="true">Add condition</button>
                                                                    <button type="button" data-add-group="true">Add group</button>
                                                                </div>
                                                            </div>
                                                            <div class="bm-condition-list" data-condition-list="true"></div>
                                                        </div>
                                                    </section>
                                                    <section class="bm-condition-branch">
                                                        <h4>Else</h4>
                                                        <div class="bm-condition-group" data-condition-group="true" data-when-part="else">
                                                            <div class="bm-condition-group-header">
                                                                <label>
                                                                    Match
                                                                    <select data-group-operator="true">
                                                                        <option value="and">All conditions</option>
                                                                        <option value="or">Any condition</option>
                                                                    </select>
                                                                </label>
                                                                <div class="bm-condition-actions">
                                                                    <button type="button" data-add-condition="true">Add condition</button>
                                                                    <button type="button" data-add-group="true">Add group</button>
                                                                </div>
                                                            </div>
                                                            <div class="bm-condition-list" data-condition-list="true"></div>
                                                        </div>
                                                    </section>
                                                </div>
                                            </div>
                                        </details>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                </form>
            </section>

            <section class="bm-designer-surface bm-dsl-surface" data-view-panel="Dsl">
                <form method="post" class="bm-dsl-form">
                    @Html.AntiForgeryToken()
                    <div class="bm-canvas-header">
                        <div>
                            <h2>Validation DSL</h2>
                        </div>
                    </div>
                    <input type="hidden" name="ActiveView" value="Dsl" />
                    <textarea name="DslContent" rows="28" data-dsl-editor="true">@Model.DslContent</textarea>
                    <section class="bm-dsl-diagnostics-panel" data-dsl-diagnostics-panel="true">
                        <button type="button" class="bm-dsl-diagnostics-header" data-dsl-diagnostics-toggle="true" aria-expanded="true">
                            <span>Errors</span>
                            <strong data-dsl-diagnostics-count="true">0</strong>
                        </button>
                        <div class="bm-dsl-diagnostics-body" data-dsl-diagnostics-body="true">
                            <div class="bm-dsl-diagnostics-empty" data-dsl-diagnostics-empty="true">No DSL diagnostics</div>
                            <div class="bm-dsl-diagnostics-list" data-dsl-diagnostics-list="true"></div>
                        </div>
                    </section>
                </form>
            </section>
        </section>
    </main>

    <template data-assertion-template="true">
        <div class="bm-validation-row bm-validation-row-assertion" data-assertion-row="true">
            <div class="bm-validation-row-top">
                <label>
                    Type
                    <select name="AssertionKinds" data-assertion-kind="true" data-validation-input="true">
                        <option value="Simple" selected>Simple field rule</option>
                        <option value="Complex">Complex assertion</option>
                    </select>
                </label>
                <label>
                    Message
                    <input name="AssertionMessages" placeholder="Validation message" data-validation-input="true" />
                </label>
                <button type="button" class="bm-validation-row-remove" data-remove-row="true">Remove</button>
            </div>
            <div class="bm-simple-rule-panel" data-simple-rule-panel="true">
                <label>
                    Field
                    <input name="SimpleFieldPaths" placeholder="$source.quantity" data-simple-field="true" data-validation-input="true" />
                </label>
                <label>
                    Operator
                    <select name="SimpleOperators" data-simple-operator="true" data-validation-input="true">
                        <option value="exists">required / exists</option>
                        <option value="notEmpty">not empty</option>
                        <option value="isEmpty">is empty</option>
                        <option value="eq">equals</option>
                        <option value="neq">not equals</option>
                        <option value="gt">greater than</option>
                        <option value="gte">greater or equal</option>
                        <option value="lt">less than</option>
                        <option value="lte">less or equal</option>
                        <option value="contains">contains</option>
                        <option value="startsWith">starts with</option>
                        <option value="endsWith">ends with</option>
                        <option value="regexMatch">matches regex</option>
                    </select>
                </label>
                <label data-simple-value-wrapper="true" hidden>
                    Value
                    <input name="SimpleValues" placeholder="10 or $other.field" data-simple-value="true" data-validation-input="true" />
                </label>
                <input type="hidden" name="AssertionExpressions" data-expression-output="true" data-validation-input="true" />
            </div>
            <div class="bm-complex-assertion-panel" data-complex-assertion-panel="true" hidden>
                <label class="bm-complex-expression">
                    Expression
                    <textarea class="bm-expression-input" rows="3" placeholder="and(gt($source.quantity, 10), exists($source.id))" data-complex-expression-editor="true" data-validation-input="true"></textarea>
                </label>
                <details class="bm-condition-builder" data-condition-builder="true">
                    <summary>Condition builder</summary>
                    <div class="bm-condition-builder-body">
                        <label class="bm-condition-mode">
                            Mode
                            <select data-builder-mode="true">
                                <option value="group">Group</option>
                                <option value="when">If / then / else</option>
                            </select>
                        </label>
                        <div data-builder-panel="group">
                            <div class="bm-condition-group" data-condition-group="true">
                                <div class="bm-condition-group-header">
                                    <label>
                                        Match
                                        <select data-group-operator="true">
                                            <option value="and">All conditions</option>
                                            <option value="or">Any condition</option>
                                        </select>
                                    </label>
                                    <div class="bm-condition-actions">
                                        <button type="button" data-add-condition="true">Add condition</button>
                                        <button type="button" data-add-group="true">Add group</button>
                                    </div>
                                </div>
                                <div class="bm-condition-list" data-condition-list="true">
                                    <div class="bm-condition-row" data-condition-row="true">
                                        <input data-condition-left="true" placeholder="$source.field" />
                                        <select data-condition-operator="true">
                                            <option value="exists">required / exists</option>
                                            <option value="notEmpty">not empty</option>
                                            <option value="isEmpty">is empty</option>
                                            <option value="eq">equals</option>
                                            <option value="neq">not equals</option>
                                            <option value="gt">greater than</option>
                                            <option value="gte">greater or equal</option>
                                            <option value="lt">less than</option>
                                            <option value="lte">less or equal</option>
                                            <option value="contains">contains</option>
                                            <option value="startsWith">starts with</option>
                                            <option value="endsWith">ends with</option>
                                            <option value="regexMatch">matches regex</option>
                                        </select>
                                        <input data-condition-right="true" placeholder="value or $other.field" />
                                        <button type="button" data-remove-condition="true">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div data-builder-panel="when" hidden>
                            <section class="bm-condition-branch">
                                <h4>If</h4>
                                <div class="bm-condition-group" data-condition-group="true" data-when-part="condition">
                                    <div class="bm-condition-group-header">
                                        <label>
                                            Match
                                            <select data-group-operator="true">
                                                <option value="and">All conditions</option>
                                                <option value="or">Any condition</option>
                                            </select>
                                        </label>
                                        <div class="bm-condition-actions">
                                            <button type="button" data-add-condition="true">Add condition</button>
                                            <button type="button" data-add-group="true">Add group</button>
                                        </div>
                                    </div>
                                    <div class="bm-condition-list" data-condition-list="true"></div>
                                </div>
                            </section>
                            <section class="bm-condition-branch">
                                <h4>Then</h4>
                                <div class="bm-condition-group" data-condition-group="true" data-when-part="then">
                                    <div class="bm-condition-group-header">
                                        <label>
                                            Match
                                            <select data-group-operator="true">
                                                <option value="and">All conditions</option>
                                                <option value="or">Any condition</option>
                                            </select>
                                        </label>
                                        <div class="bm-condition-actions">
                                            <button type="button" data-add-condition="true">Add condition</button>
                                            <button type="button" data-add-group="true">Add group</button>
                                        </div>
                                    </div>
                                    <div class="bm-condition-list" data-condition-list="true"></div>
                                </div>
                            </section>
                            <section class="bm-condition-branch">
                                <h4>Else</h4>
                                <div class="bm-condition-group" data-condition-group="true" data-when-part="else">
                                    <div class="bm-condition-group-header">
                                        <label>
                                            Match
                                            <select data-group-operator="true">
                                                <option value="and">All conditions</option>
                                                <option value="or">Any condition</option>
                                            </select>
                                        </label>
                                        <div class="bm-condition-actions">
                                            <button type="button" data-add-condition="true">Add condition</button>
                                            <button type="button" data-add-group="true">Add group</button>
                                        </div>
                                    </div>
                                    <div class="bm-condition-list" data-condition-list="true"></div>
                                </div>
                            </section>
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </template>

    <template data-condition-row-template="true">
        <div class="bm-condition-row" data-condition-row="true">
            <input data-condition-left="true" placeholder="$source.field" />
            <select data-condition-operator="true">
                <option value="exists">required / exists</option>
                <option value="notEmpty">not empty</option>
                <option value="isEmpty">is empty</option>
                <option value="eq">equals</option>
                <option value="neq">not equals</option>
                <option value="gt">greater than</option>
                <option value="gte">greater or equal</option>
                <option value="lt">less than</option>
                <option value="lte">less or equal</option>
                <option value="contains">contains</option>
                <option value="startsWith">starts with</option>
                <option value="endsWith">ends with</option>
                <option value="regexMatch">matches regex</option>
            </select>
            <input data-condition-right="true" placeholder="value or $other.field" />
            <button type="button" data-remove-condition="true">Remove</button>
        </div>
    </template>

    <template data-condition-group-template="true">
        <div class="bm-condition-group" data-condition-group="true">
            <div class="bm-condition-group-header">
                <label>
                    Match
                    <select data-group-operator="true">
                        <option value="and">All conditions</option>
                        <option value="or">Any condition</option>
                    </select>
                </label>
                <div class="bm-condition-actions">
                    <button type="button" data-add-condition="true">Add condition</button>
                    <button type="button" data-add-group="true">Add group</button>
                    <button type="button" data-remove-group="true">Remove group</button>
                </div>
            </div>
            <div class="bm-condition-list" data-condition-list="true">
                <div class="bm-condition-row" data-condition-row="true">
                    <input data-condition-left="true" placeholder="$source.field" />
                    <select data-condition-operator="true">
                        <option value="exists">required / exists</option>
                        <option value="notEmpty">not empty</option>
                        <option value="isEmpty">is empty</option>
                        <option value="eq">equals</option>
                        <option value="neq">not equals</option>
                        <option value="gt">greater than</option>
                        <option value="gte">greater or equal</option>
                        <option value="lt">less than</option>
                        <option value="lte">less or equal</option>
                        <option value="contains">contains</option>
                        <option value="startsWith">starts with</option>
                        <option value="endsWith">ends with</option>
                        <option value="regexMatch">matches regex</option>
                    </select>
                    <input data-condition-right="true" placeholder="value or $other.field" />
                    <button type="button" data-remove-condition="true">Remove</button>
                </div>
            </div>
        </div>
    </template>
</body>
</html>
