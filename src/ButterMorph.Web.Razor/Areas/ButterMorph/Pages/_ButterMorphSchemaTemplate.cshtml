<template id="schema-field-template">
    <div class="schema-field">
        <div class="schema-field-main row g-2">
            <div class="col-md-3">
                <label class="form-label">Field</label>
                <input type="text" class="form-control field-name-input" placeholder="Field key" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <select class="form-control field-type-select">
                    <option value="string">string</option>
                    <option value="number">number</option>
                    <option value="integer">integer</option>
                    <option value="boolean">boolean</option>
                    <option value="object">object</option>
                    <option value="array">array</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Description</label>
                <input type="text" class="form-control field-description-input" placeholder="Short field description" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input field-required-input" type="checkbox" />
                    <label class="form-check-label">Required</label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="schema-field-actions">
                    <button type="button" class="btn btn-secondary btn-sm field-validation-btn schema-icon-btn" title="Field validation" aria-label="Field validation">✓</button>
                    <button type="button" class="btn btn-secondary btn-sm field-metadata-btn schema-icon-btn" title="Field metadata" aria-label="Field metadata">◆</button>
                    <button type="button" class="btn btn-secondary btn-sm edit-object-fields-btn d-none" title="Edit object fields">{ }</button>
                    <button type="button" class="btn btn-secondary btn-sm edit-array-object-fields-btn d-none" title="Edit array item fields">[ ]</button>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-field-btn schema-icon-btn" title="Remove field" aria-label="Remove field">🗑</button>
                </div>
            </div>
        </div>
        <div class="schema-object-builder mt-2 d-none">
            <span class="schema-nested-summary object-summary">No fields configured</span>
            <div class="schema-fields-list child-fields-list"></div>
            <button type="button" class="btn btn-secondary btn-sm add-child-field-btn d-none">Add Property</button>
        </div>
        <div class="schema-array-builder mt-2 d-none">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">Array Item Type</label>
                    <select class="form-control array-item-type-select">
                        <option value="string">string</option>
                        <option value="number">number</option>
                        <option value="integer">integer</option>
                        <option value="boolean">boolean</option>
                        <option value="object">object</option>
                        <option value="array">array</option>
                    </select>
                </div>
            </div>
            <div class="schema-array-object-builder mt-2 d-none">
                <span class="schema-nested-summary array-object-summary">No fields configured</span>
                <div class="schema-fields-list array-object-fields-list"></div>
                <button type="button" class="btn btn-secondary btn-sm add-array-object-field-btn d-none">Add Property</button>
            </div>
            <div class="schema-array-nested-builder mt-2 d-none">
                <div class="schema-fields-list nested-array-item-list"></div>
                <div class="schema-add-row">
                    <button type="button" class="btn btn-secondary btn-sm add-nested-array-item-btn">Add Item</button>
                </div>
            </div>
        </div>
    </div>
</template>

<div class="modal fade" id="field-validation-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Field Validation</h5>
                <button type="button" class="btn-close" data-modal-close="field-validation-modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div id="field-validation-fields" class="row g-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="field-validation-modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-field-validation-btn">Apply</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="field-metadata-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content schema-metadata-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Field Metadata</h5>
                <button type="button" class="btn-close" data-modal-close="field-metadata-modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div id="field-metadata-fields" class="schema-metadata-fields"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="field-metadata-modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-field-metadata-btn">Apply</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="object-schema-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content object-schema-modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1" id="object-schema-modal-title">Object Properties</h5>
                    <div id="object-schema-breadcrumb" class="object-schema-breadcrumb"></div>
                </div>
                <button type="button" class="btn-close" data-modal-close="object-schema-modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div id="object-schema-fields-host" class="object-schema-fields-host"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="object-schema-back-btn">Back</button>
                <button type="button" class="btn btn-secondary" data-modal-close="object-schema-modal">Close</button>
                <button type="button" class="btn btn-primary" id="object-schema-add-field-btn">Add Property</button>
            </div>
        </div>
    </div>
</div>


