@page "/buttermorph/payload-schema/designer"
@model PayloadSchemaDesignerModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ButterMorph Payload Schema Designer</title>
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/atlas-schema.css?v=5" />
</head>
<body class="atlas-page"
      data-schema-host-save-completed="@Model.HostSaveCompleted.ToString().ToLowerInvariant()"
      data-schema-host-context-key="@Model.SavedContextKey"
      data-schema-host-message-type="ButterMorphPayloadSchemaDesignerSaved">
    <main class="atlas-shell">
        <section class="dashboard-section">
        <div class="platform-card event-editor">
        <div class="platform-card-header">
            <span>@Model.FormTitle</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="atlas-alert">@Model.Message</div>
        }

        <form id="event-editor-form" method="post" action="@Model.SaveActionUrl" class="atlas-editor-form atlas-payload-card" data-schema-host-form="true">
            @Html.AntiForgeryToken()
            <input type="hidden" id="payload-schema-json" asp-for="PayloadSchemaJson" />
            <div class="atlas-editor-scroll">
                <section class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Key</label>
                        <input class="form-control" asp-for="SchemaKey" placeholder="customer-profile" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" asp-for="SchemaName" placeholder="Customer Profile" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Descripcion</label>
                        <input class="form-control" asp-for="SchemaDescription" placeholder="Describe el payload" />
                    </div>
                </section>
                <section class="event-schema-block">
                    <div class="event-schema-header">
                        <h2 class="section-heading event-schema-title">Schema del Payload</h2>
                        <button type="button" class="btn btn-secondary btn-sm" id="add-root-field">Agregar campo</button>
                    </div>
                    <div id="schema-root-fields" class="schema-fields-list"></div>
                    <small class="text-muted d-block mt-2">
                        Tipos soportados: string, number, integer, boolean, object, array.
                    </small>
                </section>
            </div>
            <div class="contract-editor-actions">
                <button class="btn btn-primary" type="submit">Guardar schema</button>
            </div>
        </form>
        </div>
        </section>
    </main>

    <script id="schema-type-catalog" type="application/json">@Html.Raw(Model.SchemaTypeCatalogJson)</script>
    <script id="field-metadata-catalog" type="application/json">@Html.Raw(Model.FieldMetadataCatalogJson)</script>
    @await Html.PartialAsync("_AtlasSchemaTemplate")
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/atlas-schema-builder.js?v=5"></script>
    @await Html.PartialAsync("_SchemaHostFlowScript")
</body>
</html>
