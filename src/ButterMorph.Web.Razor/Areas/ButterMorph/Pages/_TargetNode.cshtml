@model ButterMorph.Web.Razor.SchemaTreeDisplayNode

@if (Model.Children.Count > 0)
{
    <details class="bm-tree-node bm-target-node" open>
        <summary>
            <span class="bm-json-key">@Model.Name</span>
            <span class="bm-json-brace">@((Model.Kind == ButterMorph.Abstractions.SchemaNodeKind.Array) ? "[" : "{")</span>
            <span class="bm-node-meta">@Model.Kind</span>
        </summary>
        @if (Model.IsArrayProjection)
        {
            <div class="bm-array-mapping"
                 data-array-drop-target="true"
                 data-array-target-path="@Model.Path">
                <input type="hidden" name="ProjectionTargetPaths" value="@Model.Path" />
                <span class="bm-for-each-label">for each</span>
                <input class="bm-expression-input bm-array-source-input"
                       name="ProjectionSources"
                       value="@Model.ProjectionSourceExpression"
                       placeholder="$source.Collection"
                       data-target-path="@(Model.Path + "::projection::source")"
                       data-array-source-input="true"
                       data-array-target-path="@Model.Path" />
                <span class="bm-for-each-label">as</span>
                <input class="bm-expression-input bm-array-alias-input"
                       name="ProjectionAliases"
                       value="@Model.ProjectionAlias"
                       placeholder="item"
                       data-target-path="@(Model.Path + "::projection::alias")"
                       data-array-alias-input="true"
                       data-array-target-path="@Model.Path" />
                <input class="bm-expression-input bm-array-advanced-input"
                       type="hidden"
                       name="ProjectionAdvancedExpressions"
                       value="@Model.ProjectionAdvancedExpression"
                       data-target-path="@(Model.Path + "::projection::advanced")" />
                <button type="button" class="bm-clear-array-mapping" aria-label="Clear array mapping">&times;</button>
            </div>
        }
        <div class="bm-tree-children @(Model.IsArrayProjection ? "bm-array-template" : string.Empty)">
            @foreach (var child in Model.Children)
            {
                <partial name="_TargetNode" model="child" />
            }
        </div>
        <div class="bm-json-close">@((Model.Kind == ButterMorph.Abstractions.SchemaNodeKind.Array) ? "]" : "}")</div>
    </details>
}
else
{
    bool isConditional = string.Equals(Model.MappingMode, "conditional", StringComparison.OrdinalIgnoreCase);
    string syncPath = Model.IsArrayTemplateField ? Model.ProjectionTargetPath + "::projection::field::" + Model.ProjectionFieldPath : Model.Path;

    <div class="bm-target-field @(Model.IsArrayTemplateField ? "bm-array-template-field" : string.Empty)"
         data-drop-target="true"
         data-array-source="@Model.ProjectionSourceExpression"
         data-array-alias="@Model.ProjectionAlias"
         data-mapping-editor="true">
        <div class="bm-target-label">
            <strong>@Model.Name</strong>
            <span>@Model.DataType</span>
        </div>
        @if (Model.IsArrayTemplateField)
        {
            <input type="hidden" name="ProjectionFieldArrayPaths" value="@Model.ProjectionTargetPath" />
            <input type="hidden" name="ProjectionFieldPaths" value="@Model.ProjectionFieldPath" />
            <input type="hidden"
                   name="ProjectionFieldModes"
                   value="@Model.MappingMode"
                   data-target-path="@(syncPath + "::mapping::mode")"
                   data-mapping-mode-hidden="true" />
        }
        else
        {
            <input type="hidden" name="TargetPaths" value="@Model.Path" />
            <input type="hidden"
                   name="MappingModes"
                   value="@Model.MappingMode"
                   data-target-path="@(syncPath + "::mapping::mode")"
                   data-mapping-mode-hidden="true" />
        }
        <div class="bm-mapping-editor-header">
            <button type="button"
                    class="bm-mapping-toggle"
                    data-toggle-mapping-mode="true"
                    aria-label="Switch mapping mode">
                @(isConditional ? "Basic" : "Conditional")
            </button>
            <button type="button" class="bm-clear-mapping" aria-label="Clear mapping">Clear</button>
        </div>
        <div class="bm-mapping-panel" data-mapping-panel="basic" hidden="@isConditional">
            <input class="bm-expression-input"
                   name="@(Model.IsArrayTemplateField ? "ProjectionFieldExpressions" : "Expressions")"
                   value="@Model.Expression"
                   data-basic-expression="true"
                   data-target-path="@syncPath"
                   title="@Model.Path" />
        </div>
        <div class="bm-conditional-panel" data-mapping-panel="conditional" hidden="@(!isConditional)">
            <input type="hidden"
                   name="@(Model.IsArrayTemplateField ? "ProjectionFieldConditions" : "ConditionalConditions")"
                   value="@Model.ConditionalConditionExpression"
                   data-conditional-output="condition"
                   data-target-path="@(syncPath + "::conditional::condition")" />
            <input type="hidden"
                   name="@(Model.IsArrayTemplateField ? "ProjectionFieldThenExpressions" : "ConditionalThenExpressions")"
                   value="@Model.ConditionalThenExpression"
                   data-conditional-output="then"
                   data-conditional-then="true"
                   data-target-path="@(syncPath + "::conditional::then")" />
            <input type="hidden"
                   name="@(Model.IsArrayTemplateField ? "ProjectionFieldElseExpressions" : "ConditionalElseExpressions")"
                   value="@Model.ConditionalElseExpression"
                   data-conditional-output="else"
                   data-target-path="@(syncPath + "::conditional::else")" />
            <div class="bm-mapping-conditional-composer" data-mapping-conditional-composer="true">
                <section class="bm-mapping-branch" data-mapping-branch="condition">
                    <h4>When</h4>
                    <div class="bm-mapping-condition-group" data-mapping-condition-group="true">
                        <div class="bm-mapping-condition-group-header">
                            <label>
                                Combine
                                <select data-mapping-group-operator="true">
                                    <option value="and">All conditions</option>
                                    <option value="or">Any condition</option>
                                </select>
                            </label>
                            <div class="bm-mapping-condition-actions">
                                <button type="button" data-add-mapping-condition="true">Add condition</button>
                                <button type="button" data-add-mapping-group="true">Add group</button>
                            </div>
                        </div>
                        <div class="bm-mapping-condition-list" data-mapping-condition-list="true">
                            <div class="bm-mapping-condition-row" data-mapping-condition-row="true">
                                <input class="bm-expression-input" data-mapping-condition-left="true" />
                                <select data-mapping-condition-operator="true">
                                    <option value="exists">required / exists</option>
                                    <option value="notEmpty">not empty</option>
                                    <option value="isEmpty">is empty</option>
                                    <option value="eq">equals</option>
                                    <option value="neq">not equals</option>
                                    <option value="gt">greater than</option>
                                    <option value="gte">greater or equal</option>
                                    <option value="lt">less than</option>
                                    <option value="lte">less or equal</option>
                                    <option value="contains">contains</option>
                                    <option value="startsWith">starts with</option>
                                    <option value="endsWith">ends with</option>
                                    <option value="regexMatch">matches regex</option>
                                </select>
                                <input class="bm-expression-input" data-mapping-condition-right="true" />
                                <button type="button" data-remove-mapping-condition="true">Remove</button>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="bm-mapping-branch" data-mapping-branch="then">
                    <h4>Then</h4>
                    <div class="bm-mapping-value-slot" data-mapping-value-slot="then">
                        <div class="bm-mapping-slot-actions">
                            <button type="button" data-set-mapping-slot-mode="expression">Expression</button>
                            <button type="button" data-set-mapping-slot-mode="conditional">Conditional</button>
                            <button type="button" data-set-mapping-slot-mode="null">Null</button>
                        </div>
                        <div class="bm-mapping-slot-expression" data-mapping-slot-panel="expression">
                            <input class="bm-expression-input"
                                   value="@Model.ConditionalThenExpression"
                                   data-mapping-slot-expression="true" />
                        </div>
                        <div class="bm-mapping-slot-conditional" data-mapping-slot-panel="conditional" hidden></div>
                    </div>
                </section>
                <section class="bm-mapping-branch" data-mapping-branch="else">
                    <h4>Otherwise</h4>
                    <div class="bm-mapping-value-slot" data-mapping-value-slot="else">
                        <div class="bm-mapping-slot-actions">
                            <button type="button" data-set-mapping-slot-mode="expression">Expression</button>
                            <button type="button" data-set-mapping-slot-mode="conditional">Conditional</button>
                            <button type="button" data-set-mapping-slot-mode="null">Null</button>
                        </div>
                        <div class="bm-mapping-slot-expression" data-mapping-slot-panel="expression">
                            <input class="bm-expression-input"
                                   value="@Model.ConditionalElseExpression"
                                   data-mapping-slot-expression="true" />
                        </div>
                        <div class="bm-mapping-slot-conditional" data-mapping-slot-panel="conditional" hidden></div>
                    </div>
                </section>
            </div>
        </div>
        @if (Model.Diagnostics.Count > 0)
        {
            <ul class="bm-field-diagnostics">
                @foreach (var diagnostic in Model.Diagnostics)
                {
                    <li>@diagnostic</li>
                }
            </ul>
        }
    </div>
}
