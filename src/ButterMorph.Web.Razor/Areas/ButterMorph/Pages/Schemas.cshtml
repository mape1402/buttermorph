@page "/buttermorph/schemas"
@model ButterMorph.Web.Razor.SchemasModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ButterMorph Schemas</title>
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/designer.css" />
</head>
<body>
    <main class="bm-shell">
        <section class="bm-page-title">
            <p class="bm-kicker">ButterMorph</p>
            <h1>Schemas moved into the designer</h1>
            <p>Source and output schemas now load directly from the left toolbox.</p>
        </section>
        <section class="bm-card">
            <p class="bm-empty">@Model.Message</p>
            <div class="bm-actions">
                <a class="bm-button" href="/buttermorph/designer">Open designer</a>
            </div>
        </section>
    </main>
</body>
</html>
