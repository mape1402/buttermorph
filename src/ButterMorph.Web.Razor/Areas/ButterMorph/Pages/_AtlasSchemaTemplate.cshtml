<template id="schema-field-template">
    <div class="schema-field">
        <div class="schema-field-main row g-2">
            <div class="col-md-3">
                <label class="form-label">Campo</label>
                <input type="text" class="form-control field-name-input" placeholder="customerId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Tipo</label>
                <select class="form-control field-type-select">
                    <option value="string">string</option>
                    <option value="number">number</option>
                    <option value="integer">integer</option>
                    <option value="boolean">boolean</option>
                    <option value="object">object</option>
                    <option value="array">array</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Descripcion</label>
                <input type="text" class="form-control field-description-input" placeholder="Breve descripcion del campo" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input field-required-input" type="checkbox" />
                    <label class="form-check-label">Requerido</label>
                </div>
            </div>
            <div class="col-md-1 d-flex align-items-end" style="padding-left:0.25rem;">
                <div class="d-flex gap-1">
                    <button type="button" class="btn btn-secondary btn-sm field-metadata-btn px-2" title="Ver mas">⋯</button>
                    <button type="button" class="btn btn-secondary btn-sm edit-object-fields-btn px-2 d-none" title="Editar propiedades">{ }</button>
                    <button type="button" class="btn btn-secondary btn-sm edit-array-object-fields-btn px-2 d-none" title="Editar estructura del item">[ ]</button>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-field-btn px-2" title="Eliminar campo">×</button>
                </div>
            </div>
        </div>
        <div class="schema-object-builder mt-2 d-none">
            <span class="schema-nested-summary object-summary">Sin propiedades configuradas</span>
            <div class="schema-fields-list child-fields-list"></div>
            <button type="button" class="btn btn-secondary btn-sm add-child-field-btn d-none">Agregar propiedad</button>
        </div>
        <div class="schema-array-builder mt-2 d-none">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">Tipo de item (array)</label>
                    <select class="form-control array-item-type-select">
                        <option value="string">string</option>
                        <option value="number">number</option>
                        <option value="integer">integer</option>
                        <option value="boolean">boolean</option>
                        <option value="object">object</option>
                        <option value="array">array</option>
                    </select>
                </div>
            </div>
            <div class="schema-array-object-builder mt-2 d-none">
                <span class="schema-nested-summary array-object-summary">Sin propiedades configuradas</span>
                <div class="schema-fields-list array-object-fields-list"></div>
                <button type="button" class="btn btn-secondary btn-sm add-array-object-field-btn d-none">Agregar propiedad</button>
            </div>
            <div class="schema-array-nested-builder mt-2 d-none">
                <div class="schema-fields-list nested-array-item-list"></div>
                <div class="schema-add-row">
                    <button type="button" class="btn btn-secondary btn-sm add-nested-array-item-btn">Agregar item</button>
                </div>
            </div>
        </div>
    </div>
</template>

<div class="modal fade" id="field-metadata-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Metadata del campo</h5>
                <button type="button" class="btn-close" data-modal-close="field-metadata-modal" aria-label="Cerrar">×</button>
            </div>
            <div class="modal-body">
                <div id="field-metadata-validation" class="alert alert-danger d-none"></div>
                <div id="field-validation-section" class="field-validation-section mb-3">
                    <h6 class="field-modal-section-title">Validaciones del campo</h6>
                    <div id="field-validation-fields" class="row g-3"></div>
                </div>
                <h6 class="field-modal-section-title">Custom fields</h6>
                <div id="field-metadata-fields" class="row g-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="field-metadata-modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="save-field-metadata-btn">Aplicar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="object-schema-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content object-schema-modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1" id="object-schema-modal-title">Propiedades del objeto</h5>
                    <div id="object-schema-breadcrumb" class="object-schema-breadcrumb"></div>
                </div>
                <button type="button" class="btn-close" data-modal-close="object-schema-modal" aria-label="Cerrar">×</button>
            </div>
            <div class="modal-body">
                <div id="object-schema-fields-host" class="object-schema-fields-host"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="object-schema-back-btn">Volver</button>
                <button type="button" class="btn btn-secondary" data-modal-close="object-schema-modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="object-schema-add-field-btn">Agregar propiedad</button>
            </div>
        </div>
    </div>
</div>