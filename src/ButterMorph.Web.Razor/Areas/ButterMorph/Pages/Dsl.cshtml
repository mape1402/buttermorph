@page "/buttermorph/dsl"
@model ButterMorph.Web.Razor.DslModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ButterMorph DSL</title>
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/designer.css" />
</head>
<body>
    <main class="bm-shell">
        <section class="bm-page-title">
            <p class="bm-kicker">ButterMorph</p>
            <h1>DSL moved into the designer</h1>
            <p>The DSL editor is now a top-level view inside the mapping designer.</p>
        </section>
        <section class="bm-card">
            <p class="bm-empty">@Model.Message</p>
            <div class="bm-actions">
                <a class="bm-button" href="/buttermorph/designer">Open designer</a>
            </div>
        </section>
    </main>
</body>
</html>
