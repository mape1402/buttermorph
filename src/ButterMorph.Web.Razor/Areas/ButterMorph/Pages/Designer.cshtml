@page "/buttermorph/designer"
@model ButterMorph.Web.Razor.DesignerModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ButterMorph Designer</title>
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/designer.css?v=no-page-scroll-1" />
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/designer.js?v=no-page-scroll-1"></script>
</head>
<body>
    <main class="bm-workbench" data-active-view="@Model.ActiveView">
        <header class="bm-topbar">
            <div>
                <p class="bm-kicker">ButterMorph</p>
                <h1>Mapping Designer</h1>
            </div>
            <div class="bm-view-toggle" role="group" aria-label="Designer view">
                <button type="button" class="bm-view-button" data-view="Visual">Visual Designer</button>
                <button type="button" class="bm-view-button" data-view="Dsl">DSL</button>
            </div>
            <form method="post" asp-page-handler="LoadDemo" class="bm-toolbar-form">
                <button type="submit">Load Demo</button>
            </form>
        </header>

        <section class="bm-status">
            <span>@Model.Message</span>
            @if (Model.Diagnostics.Count > 0)
            {
                <strong>@Model.Diagnostics.Count diagnostics</strong>
            }
            else
            {
                <strong>Ready</strong>
            }
        </section>

        <section class="bm-workspace">
            <aside class="bm-toolbox">
                <div class="bm-panel-title">
                    <h2>Sources</h2>
                </div>

                <details class="bm-drawer">
                    <summary>Add source schema</summary>
                    <form method="post" asp-page-handler="LoadSourceSchema" class="bm-stack-form">
                        <label>
                            Source key
                            <input name="SourceKey" value="@Model.SourceKey" />
                        </label>
                        <label>
                            JSON Schema
                            <textarea name="SourceSchemaJson" rows="9">@Model.SourceSchemaJson</textarea>
                        </label>
                        <button type="submit">Load source</button>
                    </form>
                </details>

                <details class="bm-drawer">
                    <summary>Load output schema</summary>
                    <form method="post" asp-page-handler="LoadTargetSchema" class="bm-stack-form">
                        <label>
                            Target JSON Schema
                            <textarea name="TargetSchemaJson" rows="9">@Model.TargetSchemaJson</textarea>
                        </label>
                        <button type="submit">Load target</button>
                    </form>
                </details>

                @if (Model.SourceSchemas.Count == 0)
                {
                    <p class="bm-empty">No sources loaded. Use Load Demo or add a source schema.</p>
                }

                <div class="bm-source-list">
                    @foreach (var source in Model.SourceSchemas)
                    {
                        <section class="bm-source-group">
                            <h3>@source.Key</h3>
                            @foreach (var child in source.Root.Children)
                            {
                                <partial name="_SourceNode" model="child" />
                            }
                        </section>
                    }
                </div>
            </aside>

            <section class="bm-designer-surface" data-view-panel="Visual">
                <form method="post" asp-page-handler="SaveTargetMappings" class="bm-target-form">
                    <div class="bm-canvas-header">
                        <div>
                            <h2>Output schema</h2>
                        </div>
                        <button type="submit">Save mappings</button>
                    </div>

                    @if (Model.TargetTree.Children.Count == 0)
                    {
                        <p class="bm-empty">No output schema loaded. Load the target schema from the toolbox.</p>
                    }
                    else
                    {
                        <div class="bm-json-canvas">
                            @foreach (var child in Model.TargetTree.Children)
                            {
                                <partial name="_TargetNode" model="child" />
                            }
                        </div>
                    }
                </form>
            </section>

            <section class="bm-designer-surface bm-dsl-surface" data-view-panel="Dsl">
                <form method="post" class="bm-dsl-form">
                    <div class="bm-canvas-header">
                        <div>
                            <h2>DSL</h2>
                            <p>Import or export the same mapping document used by the visual designer.</p>
                        </div>
                        <div class="bm-actions">
                            <button type="submit" asp-page-handler="ImportDsl">Import DSL</button>
                            <button type="submit" asp-page-handler="ExportDsl">Export DSL</button>
                        </div>
                    </div>
                    <input type="hidden" name="ActiveView" value="Dsl" />
                    <textarea name="DslContent" rows="28">@Model.DslContent</textarea>
                </form>
            </section>
        </section>
    </main>
</body>
</html>
