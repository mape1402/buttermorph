@page "/buttermorph/designer"
@model ButterMorph.Web.Razor.DesignerModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ButterMorph Designer</title>
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/codemirror.min.css?v=codemirror-5-65-16" />
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/show-hint.min.css?v=codemirror-5-65-16" />
    <link rel="stylesheet" href="/_content/ButterMorph.Web.Razor/buttermorph/designer.css?v=designer-scroll-1" />
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/codemirror.min.js?v=codemirror-5-65-16"></script>
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/vendor/codemirror/show-hint.min.js?v=codemirror-5-65-16"></script>
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/designer.js?v=frame-flow-1"></script>
</head>
<body>
    <main class="bm-workbench"
          data-active-view="@Model.ActiveView"
          data-left-dock-mode="pinned"
          data-host-save-completed="@Model.HostSaveCompleted.ToString().ToLowerInvariant()"
          data-host-context-key="@Model.SavedContextKey"
          data-host-return-url="@Model.SafeReturnUrl">
        <header class="bm-topbar">
            <div>
                <p class="bm-kicker">ButterMorph</p>
                <h1>Mapping Designer</h1>
            </div>
            <div class="bm-view-toggle" role="group" aria-label="Designer view">
                <button type="button" class="bm-view-button" data-view="Visual">Visual Designer</button>
                <button type="button" class="bm-view-button" data-view="Dsl">DSL</button>
            </div>
        </header>

        <section class="bm-message-box @(((string.IsNullOrWhiteSpace(Model.Message) || Model.Message == "Ready.") && Model.Diagnostics.Count == 0) ? "bm-message-hidden" : string.Empty)" data-message-box="true">
            <span data-message-text="true">@Model.Message</span>
            @if (Model.Diagnostics.Count > 0)
            {
                <strong data-diagnostics-count="true">@Model.Diagnostics.Count diagnostics</strong>
            }
            else
            {
                <strong data-diagnostics-count="true">Ready</strong>
            }
            <button type="button" class="bm-message-close" data-message-close="true">&times;</button>
        </section>

        <section class="bm-workspace">
            <aside class="bm-left-dock" data-left-dock="true">
                <div class="bm-dock-tabs" role="tablist" aria-label="Designer tool windows">
                    <button type="button"
                            class="bm-dock-tab"
                            data-dock-tab="sources"
                            role="tab"
                            aria-selected="true"
                            title="Sources">
                        Sources
                    </button>
                    <button type="button"
                            class="bm-dock-tab"
                            data-dock-tab="functions"
                            role="tab"
                            aria-selected="false"
                            title="Functions">
                        Functions
                    </button>
                </div>

                <div class="bm-dock-panel-host" data-dock-panel-host="true">
                    <section class="bm-dock-panel bm-toolbox" data-dock-panel="sources" tabindex="-1">
                        <div class="bm-dock-titlebar bm-panel-title">
                            <h2>Sources</h2>
                            <button type="button" class="bm-dock-pin bm-toolbox-pin" data-dock-pin="sources" data-pin-state="pinned" aria-pressed="true" title="Auto hide panel"><span class="bm-pin-icon" aria-hidden="true"></span></button>
                        </div>

                        <div class="bm-dock-content bm-toolbox-content">
                            @if (Model.ShowSchemaActions)
                            {
                                <div class="bm-toolbox-actions">
                                    <button type="button" data-open-modal="source">Add source</button>
                                    <button type="button" data-open-modal="output">Load output</button>
                                </div>
                            }

                            @if (Model.SourceSchemas.Count == 0)
                            {
                                <p class="bm-empty">No sources loaded. Add a source schema.</p>
                            }

                            <div class="bm-source-list">
                                @foreach (var source in Model.SourceSchemas)
                                {
                                    <article class="bm-source-card">
                                        <details class="bm-source-group">
                                            <summary class="bm-source-group-header">
                                                <span class="bm-node-name">@source.Key</span>
                                                <span class="bm-source-meta">@source.SchemaKey · v@source.Version</span>
                                                @if (!string.IsNullOrWhiteSpace(source.Topic))
                                                {
                                                    <span class="bm-source-meta">topic: @source.Topic</span>
                                                }
                                                <span class="bm-source-badge">Source</span>
                                            </summary>
                                            <div class="bm-source-tree">
                                                @foreach (var child in source.Root.Children)
                                                {
                                                    <partial name="_SourceNode" model="child" />
                                                }
                                            </div>
                                        </details>
                                    </article>
                                }
                            </div>
                        </div>
                    </section>
                    <section class="bm-dock-panel bm-function-toolbox" data-dock-panel="functions" tabindex="-1" hidden>
                        <div class="bm-dock-titlebar bm-panel-title">
                            <h2>Functions</h2>
                            <button type="button" class="bm-dock-pin bm-toolbox-pin" data-dock-pin="functions" data-pin-state="pinned" aria-pressed="true" title="Auto hide panel"><span class="bm-pin-icon" aria-hidden="true"></span></button>
                        </div>

                        <div class="bm-dock-content bm-function-content">
                            <div class="bm-function-search">
                                <input type="search" placeholder="Search functions" data-function-search="true" aria-label="Search functions" />
                            </div>

                            @if (Model.FunctionCategories.Count == 0)
                            {
                                <p class="bm-empty">No functions registered.</p>
                            }

                            <div class="bm-function-list">
                                @foreach (var category in Model.FunctionCategories)
                                {
                                    <details class="bm-function-group">
                                        <summary class="bm-function-group-header">
                                            <span>@category.Name</span>
                                            <span>@category.Functions.Count</span>
                                        </summary>
                                        <div class="bm-function-group-items">
                                            @foreach (var function in category.Functions)
                                            {
                                                <button type="button"
                                                        class="bm-function-item"
                                                        draggable="true"
                                                        data-function-template="@function.Template"
                                                        data-function-search-text="@function.Category @function.Key @function.DisplayName @function.Description"
                                                        title="@function.Description">
                                                    <span class="bm-function-key">@function.Key</span>
                                                    <span class="bm-function-kind">@function.ValueKind</span>
                                                    <span class="bm-function-template">@function.Template</span>
                                                </button>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        </div>
                    </section>
                </div>
            </aside>

            <section class="bm-designer-surface" data-view-panel="Visual">
                <form method="post" asp-page-handler="SaveTargetMappings" class="bm-target-form">
                    <div class="bm-canvas-header">
                        <div>
                            <h2>Output schema</h2>
                        </div>
                        <button type="submit">Save mappings</button>
                    </div>

                    @if (Model.TargetTree.Children.Count == 0)
                    {
                        <p class="bm-empty">No output schema loaded. Load the target schema from the toolbox.</p>
                    }
                    else
                    {
                        <div class="bm-json-canvas">
                            @foreach (var child in Model.TargetTree.Children)
                            {
                                <partial name="_TargetNode" model="child" />
                            }
                        </div>
                    }
                </form>
            </section>

            <section class="bm-designer-surface bm-dsl-surface" data-view-panel="Dsl">
                <form method="post" class="bm-dsl-form">
                    <div class="bm-canvas-header">
                        <div>
                            <h2>DSL</h2>
                        </div>
                    </div>
                    <input type="hidden" name="ActiveView" value="Dsl" />
                    <textarea name="DslContent" rows="28" data-dsl-editor="true">@Model.DslContent</textarea>
                    <section class="bm-dsl-diagnostics-panel" data-dsl-diagnostics-panel="true">
                        <button type="button" class="bm-dsl-diagnostics-header" data-dsl-diagnostics-toggle="true" aria-expanded="true">
                            <span>Errors</span>
                            <strong data-dsl-diagnostics-count="true">0</strong>
                        </button>
                        <div class="bm-dsl-diagnostics-body" data-dsl-diagnostics-body="true">
                            <div class="bm-dsl-diagnostics-empty" data-dsl-diagnostics-empty="true">No DSL diagnostics</div>
                            <div class="bm-dsl-diagnostics-list" data-dsl-diagnostics-list="true"></div>
                        </div>
                    </section>
                </form>
            </section>
        </section>

        <div class="bm-modal-backdrop" data-modal="source" aria-hidden="true">
            <div class="bm-modal" role="dialog" aria-modal="true" aria-label="Add source">
                <div class="bm-modal-header">
                    <h2>Add source</h2>
                    <button type="button" class="bm-modal-close" data-close-modal="true">&times;</button>
                </div>
                <form method="post" asp-page-handler="LoadSourceSchema" enctype="multipart/form-data" class="bm-stack-form">
                    <label>
                        Source name
                        <input name="SourceName" value="@Model.SourceName" />
                    </label>
                    <label>
                        Choose file
                        <input type="file" name="SourceSchemaFile" accept=".json,application/json" />
                    </label>
                    <label>
                        Paste schema
                        <textarea name="SourceSchemaText" rows="9">@Model.SourceSchemaText</textarea>
                    </label>
                    <button type="submit">Load source</button>
                </form>
            </div>
        </div>

        <div class="bm-modal-backdrop" data-modal="output" aria-hidden="true">
            <div class="bm-modal" role="dialog" aria-modal="true" aria-label="Load output schema">
                <div class="bm-modal-header">
                    <h2>Load output schema</h2>
                    <button type="button" class="bm-modal-close" data-close-modal="true">&times;</button>
                </div>
                <form method="post" asp-page-handler="LoadTargetSchema" enctype="multipart/form-data" class="bm-stack-form">
                    <label>
                        Choose file
                        <input type="file" name="OutputSchemaFile" accept=".json,application/json" />
                    </label>
                    <label>
                        Paste schema
                        <textarea name="OutputSchemaText" rows="9">@Model.OutputSchemaText</textarea>
                    </label>
                    <button type="submit">Load target</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
