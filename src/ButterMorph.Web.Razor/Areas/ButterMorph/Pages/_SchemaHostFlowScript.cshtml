<script>
    (function () {
        completeHostFlow();

        var parameters = new URLSearchParams(window.location.search);
        if (parameters.get("popup") !== "true") {
            return;
        }

        document.addEventListener("submit", function (event) {
            var form = resolveHostForm(event.target);
            if (!form) {
                return;
            }

            event.preventDefault();
            sendHostFlowSave(form);
        }, true);

        document.addEventListener("click", function (event) {
            var button = event.target && event.target.closest
                ? event.target.closest("button[type='submit'],input[type='submit']")
                : null;

            if (!button) {
                return;
            }

            var form = resolveHostForm(button.form);
            if (!form) {
                return;
            }

            event.preventDefault();
            sendHostFlowSave(form);
        }, true);

        async function sendHostFlowSave(form) {
            if (form.getAttribute("data-schema-host-submitting") === "true") {
                return;
            }

            if (!syncHostForm(form)) {
                return;
            }

            form.setAttribute("data-schema-host-submitting", "true");
            var response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                credentials: "same-origin",
                headers: {
                    "X-ButterMorph-Host-Flow": "true"
                }
            });
            form.removeAttribute("data-schema-host-submitting");

            var contentType = response.headers.get("content-type") || "";
            if (!response.ok || contentType.indexOf("application/json") < 0) {
                document.open();
                document.write(await response.text());
                document.close();
                return;
            }

            var result = await response.json();
            if (!readValue(result, "hostSaveCompleted")) {
                return;
            }

            completeHostFlow(result);
        }

        function syncHostForm(form) {
            if (window.ButterMorphPayloadMetadataSync && !window.ButterMorphPayloadMetadataSync()) {
                return false;
            }

            if (window.ButterMorphPayloadSchemaSync) {
                var schemaSyncResult = window.ButterMorphPayloadSchemaSync();
                if (schemaSyncResult === false) {
                    return false;
                }
            }

            return true;
        }

        function resolveHostForm(candidate) {
            if (!candidate) {
                return null;
            }

            if (candidate.matches && candidate.matches("[data-schema-host-form='true']")) {
                return candidate;
            }

            if (candidate.closest) {
                return candidate.closest("[data-schema-host-form='true']");
            }

            return null;
        }

        function completeHostFlow(response) {
            var body = document.body;
            var completed = response
                ? readValue(response, "hostSaveCompleted")
                : body && body.getAttribute("data-schema-host-save-completed") === "true";

            if (!completed) {
                if (response) {
                    showHostFlowMessage("Save failed. Review the details and try again.", readValue(response, "message") || "Save failed.");
                }
                return;
            }

            var message = {
                type: response ? readValue(response, "messageType") || "" : body.getAttribute("data-schema-host-message-type") || "",
                contextKey: response ? readValue(response, "savedContextKey") || "" : body.getAttribute("data-schema-host-context-key") || ""
            };
            var returnUrl = response ? readValue(response, "safeReturnUrl") || "" : "";

            if (body) {
                body.setAttribute("data-schema-host-close-requested", "true");
            }

            completePopup(message, returnUrl);
        }

        function completePopup(message, returnUrl) {
            if (window.opener && !window.opener.closed) {
                window.opener.postMessage(message, window.location.origin);
                window.close();
                return;
            }

            if (window.parent && window.parent !== window) {
                window.parent.postMessage(message, window.location.origin);
                return;
            }

            if (returnUrl.length > 0) {
                var destination = new URL(returnUrl, window.location.origin);
                if (message.contextKey.length > 0) {
                    destination.searchParams.set("buttermorphSavedSchemaContext", message.contextKey);
                }
                window.location.assign(destination.pathname + destination.search + destination.hash);
            }
        }

        function showHostFlowMessage(message, detail) {
            var alert = document.querySelector(".bm-schema-alert");
            if (!alert) {
                alert = document.createElement("div");
                alert.className = "bm-schema-alert";
                alert.innerHTML = "<div class='bm-schema-alert-dialog' role='alertdialog' aria-modal='true' aria-labelledby='bm-schema-alert-title'>" +
                    "<div id='bm-schema-alert-title' class='bm-schema-alert-title'>Message</div>" +
                    "<div class='bm-schema-alert-message'></div>" +
                    "<details class='bm-schema-alert-details'><summary>Details</summary><div class='bm-schema-alert-detail-list'></div></details>" +
                    "<div class='bm-schema-alert-actions'><button type='button' class='btn btn-primary bm-schema-alert-close'>OK</button></div>" +
                    "</div>";
                var closeButton = alert.querySelector(".bm-schema-alert-close");
                if (closeButton) {
                    closeButton.addEventListener("click", function () {
                        alert.remove();
                    });
                }
                var form = document.querySelector("[data-schema-host-form='true']");
                if (form && form.parentElement) {
                    form.parentElement.insertBefore(alert, form);
                }
            }
            var messageNode = alert.querySelector(".bm-schema-alert-message");
            if (messageNode) {
                messageNode.textContent = message || "Save failed.";
            }
            var detailsNode = alert.querySelector(".bm-schema-alert-details");
            var listNode = alert.querySelector(".bm-schema-alert-detail-list");
            if (detailsNode && listNode) {
                if (detail) {
                    detailsNode.classList.remove("d-none");
                    detailsNode.removeAttribute("open");
                    listNode.textContent = "";
                    var item = document.createElement("div");
                    item.className = "bm-schema-alert-detail-item";
                    item.textContent = detail;
                    listNode.appendChild(item);
                } else {
                    detailsNode.classList.add("d-none");
                    detailsNode.removeAttribute("open");
                    listNode.textContent = "";
                }
            }
        }

        function readValue(source, camelName) {
            if (!source) {
                return "";
            }

            if (source[camelName] !== undefined) {
                return source[camelName];
            }

            var pascalName = camelName.charAt(0).toUpperCase() + camelName.slice(1);
            if (source[pascalName] !== undefined) {
                return source[pascalName];
            }

            return "";
        }
    }());
</script>
